# Normalize text line endings in the repo; check out native on Windows.
* text=auto

# Explicit text types
*.py    text diff=python
*.md    text
*.txt   text
*.yml   text
*.yaml  text
*.toml  text
*.json  text
*.cfg   text
*.ini   text

# Shell scripts must keep LF even on Windows
*.sh    text eol=lf

# Binary: never diff or line-ending-convert these
*.docx  binary
*.xlsx  binary
*.xls   binary
*.pdf   binary
*.png   binary
*.jpg   binary
*.parquet binary
*.pt    binary
*.pth   binary
*.ckpt  binary
*.safetensors binary
